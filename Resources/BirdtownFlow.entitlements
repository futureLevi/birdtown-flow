<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox on purpose. The shortcut needs a system-wide event tap and typing
	     needs Accessibility access to other apps, and the sandbox allows neither, so Birdtown
	     Flow ships outside the Mac App Store, signed for direct download. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<key>com.apple.security.automation.apple-events</key>
	<true/>
</dict>
</plist>
